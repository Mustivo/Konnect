# ========================================================
# KONNECT Virtual Classroom - Environment Configuration
# ========================================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-konnect-virtual-classroom-change-this-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=konnect_db
DB_USER=postgres
DB_PASSWORD=change_this_to_your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Optional unified DATABASE_URL:
# DATABASE_URL=postgres://postgres:password@localhost:5432/konnect_db

# CORS Allowed Origins (Frontend React/Vue/Next.js dev ports)
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# JWT Lifetimes
ACCESS_TOKEN_LIFETIME_HOURS=24
REFRESH_TOKEN_LIFETIME_DAYS=7

# Security Throttling Rates
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_AUTH_RATE=10/minute
